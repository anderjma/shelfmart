# PostgreSQL connection string used by the backend.
# For local docker-compose testing you can leave this unset to fall back to the
# bundled postgres service; for Supabase or another managed instance, set the
# full Npgsql connection string here.
DATABASE_URL=Host=postgres;Port=5432;Database=shelfmart;Username=postgres;Password=postgres

# Secret key used to sign and validate JWTs. Must be at least 32 characters.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters

# Comma-separated list of origins allowed to call the backend API via CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Base URL of the backend API, consumed by the frontend at build time.
VITE_API_URL=http://localhost:8080
