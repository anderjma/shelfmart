# Environment variables file for Docker Compose (ShelfMart API)
# Copy this file as '.env' in this same folder and set your real values before deploying.

# Environment (use 'Production' for production)
ASPNETCORE_ENVIRONMENT=Production

# Secret key to sign JWT tokens (must be long and secure)
JWT_SECRET=ChangeThisKeyToAVerySecureOneAtLeast32Characters!

# Allowed origin for CORS (the URL from which the frontend will be accessed)
# Example: https://my-domain.com
FRONTEND_URL=http://localhost:5173

# Cloud database (Optional - Supabase / Neon / AWS)
# Leave this variable empty or commented out if you want to use the local 'db' PostgreSQL container.
# DATABASE_URL=Host=aws-0-us-west-1.pooler.supabase.com;Database=postgres;Username=postgres.your_project;Password=your_password;Port=5432

# BACKEND_PORT=5000
# DB_PORT=5432
