# Environment variables file for Docker Compose (ShelfMart Frontend)
# Copy this file as '.env' in this same folder and set your real values before deploying.

# Backend API URL accessible by the end user's browser.
# IMPORTANT: If you're going to use a real domain, you must set the API's public URL here before running 'docker-compose up --build'.
VITE_API_URL=http://localhost:5000/api

# Supabase credentials and endpoints for uploading and reading product images.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# FRONTEND_PORT=5173
